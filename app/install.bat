@echo off
:: Per-app dependency install (Nuxt). Run from the package.json folder.
:: --ignore-scripts skips `nuxt prepare` (which needs the config server) during a
:: cold install; native deps are rebuilt after. Generated by makeInstallBats.sh.
if exist package-lock.json del /q package-lock.json
if exist npm-shrinkwrap.json del /q npm-shrinkwrap.json
call pnpm install --ignore-scripts
if errorlevel 1 exit /b 1
call pnpm rebuild better-sqlite3 sharp >nul 2>&1
exit /b 0
